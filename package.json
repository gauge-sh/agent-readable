{
  "name": "agent-readable",
  "version": "0.4.1",
  "description": "Serve clean Markdown versions of your website to AI coding agents and search crawlers\u2014statically or at runtime.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-readable": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    },
    "./next": {
      "types": "./src/next.d.ts",
      "default": "./src/next.js"
    },
    "./next/server": {
      "types": "./src/next-server.d.ts",
      "default": "./src/next-server.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./html": {
      "types": "./src/html.d.ts",
      "default": "./src/html.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js build --cwd examples/site",
    "lint": "node scripts/check-syntax.js",
    "test:package": "node scripts/smoke-package.js",
    "check": "npm run lint && npm test && npm run test:package",
    "prepublishOnly": "npm run check",
    "smoke:agent": "node examples/agent-smoke/run.mjs",
    "test:next": "node scripts/next-production.js",
    "test:netlify": "node scripts/netlify-production.js"
  },
  "dependencies": {
    "@mintlify/agent-traffic": "0.1.0",
    "cheerio": "1.1.2",
    "smol-toml": "1.9.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauge-sh/agent-readable.git"
  },
  "homepage": "https://github.com/gauge-sh/agent-readable#readme",
  "bugs": {
    "url": "https://github.com/gauge-sh/agent-readable/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "markdown",
    "llms-txt",
    "content-negotiation",
    "nextjs",
    "vercel",
    "claude-code",
    "codex"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Gauge",
  "types": "./src/index.d.ts",
  "typesVersions": {
    "*": {
      "runtime": [
        "src/runtime.d.ts"
      ],
      "node": [
        "src/node.d.ts"
      ],
      "next": [
        "src/next.d.ts"
      ],
      "next/server": [
        "src/next-server.d.ts"
      ],
      "react": [
        "src/react.d.ts"
      ],
      "html": [
        "src/html.d.ts"
      ]
    }
  }
}
